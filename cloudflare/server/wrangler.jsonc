{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "norulo-server-local",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "NORULO_D1_ACCESS_ENABLED": "1",
    "NORULO_MODE": "local",
    "NORULO_PREVIEW_SCHEMA_V11_UPGRADE_ENABLED": "0",
    "NORULO_PREVIEW_BUSINESS_CLEAR_ID": "",
    "NORULO_PREVIEW_BUSINESS_CLEAR_MANIFEST": "",
    "NORULO_EMAIL_AUTH_ENABLED": "0",
    "NORULO_PLAN_LIMITS_JSON": "{\"free\":{\"projects\":3,\"records\":100,\"writesPerMinute\":10,\"writesPerMonth\":1000,\"jevMonthlyBudgetUsd\":\"0.00\"},\"pro\":{\"projects\":20,\"records\":20000,\"writesPerMinute\":60,\"writesPerMonth\":10000,\"jevMonthlyBudgetUsd\":\"3.00\"},\"max\":{\"projects\":100,\"records\":100000,\"writesPerMinute\":60,\"writesPerMonth\":10000,\"jevMonthlyBudgetUsd\":\"5.00\"}}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "norulo-cf1-local-only",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ]
}
