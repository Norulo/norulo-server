{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "norulo-server-production",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 9000
  },
  "secrets": {
    "required": [
      "NORULO_GITHUB_CLIENT_SECRET",
      "NORULO_GITHUB_TOKEN_KEY",
      "NORULO_EMAIL_CODE_SECRET",
      "TYPESAFE_API_KEY"
    ]
  },
  "routes": [
    {
      "pattern": "api.norulo.com",
      "custom_domain": true,
      "zone_id": "deef49a196452b7efa6f9b7128e4d37b"
    }
  ],
  "vars": {
    "NORULO_D1_ACCESS_ENABLED": "0",
    "NORULO_MODE": "production",
    "NORULO_PREVIEW_SCHEMA_V11_UPGRADE_ENABLED": "0",
    "NORULO_PREVIEW_BUSINESS_CLEAR_ID": "",
    "NORULO_PREVIEW_BUSINESS_CLEAR_MANIFEST": "",
    "NORULO_EMAIL_AUTH_ENABLED": "0",
    "NORULO_EMAIL_FROM": "login@auth.norulo.com",
    "NORULO_APP_URL": "https://norulo.com",
    "NORULO_GITHUB_CALLBACK_URL": "https://norulo.com/api/auth/github/callback",
    "NORULO_GITHUB_CLIENT_ID": "Iv23li78ZPeUgSxJkLUj",
    "NORULO_GITHUB_APP_SLUG": "norulo",
    "NORULO_CREEM_API_BASE_URL": "https://api.creem.io",
    "NORULO_CREEM_PRODUCT_IDS_JSON": "{}",
    "NORULO_ALLOWED_ORIGINS": "https://norulo.com",
    "NORULO_COOKIE_SAME_SITE": "None",
    "NORULO_PLAN_LIMITS_JSON": "{\"free\":{\"projects\":3,\"records\":300,\"writesPerMinute\":10,\"writesPerMonth\":1000,\"jevMonthlyBudgetUsd\":\"0.00\"},\"pro\":{\"projects\":20,\"records\":20000,\"writesPerMinute\":60,\"writesPerMonth\":10000,\"jevMonthlyBudgetUsd\":\"3.00\"},\"max\":{\"projects\":100,\"records\":200000,\"writesPerMinute\":60,\"writesPerMonth\":10000,\"jevMonthlyBudgetUsd\":\"12.00\"}}",
    "NORULO_JEV_SUGGESTIONS_ENABLED": "0",
    "NORULO_JEV_SUGGESTIONS_EVALUATED": "0",
    "NORULO_RECURRING_EXPENSES_ENABLED": "0"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "login@auth.norulo.com"
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EMAIL_ADMISSION",
        "class_name": "EmailAdmission"
      },
      {
        "name": "RECURRING_SCHEDULER",
        "class_name": "RecurringScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "norulo-email-admission-v1",
      "new_sqlite_classes": [
        "EmailAdmission"
      ]
    },
    {
      "tag": "norulo-recurring-scheduler-v1",
      "new_sqlite_classes": [
        "RecurringScheduler"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "norulo-ledger-production",
      "database_id": "c41a1ab7-dffa-4c5d-a213-25f1bb6c78c5",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "84e421f26c708c0cf437e287eed11fa1",
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1576996832",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_IP_BURST_RATE_LIMIT",
      "namespace_id": "1744429548",
      "simple": {
        "limit": 300,
        "period": 10
      }
    },
    {
      "name": "API_IP_RATE_LIMIT",
      "namespace_id": "1820219268",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    },
    {
      "name": "API_CREDENTIAL_BURST_RATE_LIMIT",
      "namespace_id": "1012765925",
      "simple": {
        "limit": 120,
        "period": 10
      }
    },
    {
      "name": "API_CREDENTIAL_RATE_LIMIT",
      "namespace_id": "1009527699",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
