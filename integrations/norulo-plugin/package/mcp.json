{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "norulo": {
      "type": "streamable-http",
      "url": "https://mcp.norulo.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "profile:read"
            ],
            "defaultScopes": [
              "profile:read",
              "projects:read",
              "categories:read",
              "expenses:read",
              "reports:read"
            ]
          }
        }
      }
    }
  }
}
